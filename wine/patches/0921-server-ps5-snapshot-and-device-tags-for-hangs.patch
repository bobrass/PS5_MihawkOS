+    inprocess_server_locked();
 }
 
 /* Run a request on the calling thread, which is the client thread tid of
@@ -427,6 +432,7 @@ DECLSPEC_EXPORT int pw_wineserver_call_direct( unsigned int tid, client_ptr_t te
     lock_server_for_client();
     if (!inprocess_direct_ok || !(thread = get_thread_from_id( tid )))
     {
+        inprocess_server_unlocking();
         pthread_mutex_unlock( &inprocess_server_mutex );
         return 1;
     }
@@ -473,6 +479,7 @@ DECLSPEC_EXPORT int pw_wineserver_call_direct( unsigned int tid, client_ptr_t te
         thread->req_data = NULL;
     }
     release_object( thread );
+    inprocess_server_unlocking();
     pthread_mutex_unlock( &inprocess_server_mutex );
     return ret;
 }
