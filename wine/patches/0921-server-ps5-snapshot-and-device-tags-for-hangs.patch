  server/fd.c               | 28 ++++++++++++++++++++++
  server/inproc_sync.c      | 42 ++++++++++++++++++++++++++++++++-
  server/request.c          |  9 ++++++-
  server/request.h          |  6 +++++
  server/thread.c           | 60 +++++++++++++++++++++++++++++++++++++++++++----
  7 files changed, 156 insertions(+), 7 deletions(-)

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index d7b2e6f..98837cd 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1567,6 +1567,8 @@ static void (*unregister_server_thread)( long tid );
 static int (*flush_server)( unsigned int timeout_ms );
 /* and ends every process on request, for a game that does not close */
 static int (*terminate_server)( void );
+/* and prints what every thread waits on, for a game that hangs */
+static int (*snapshot_server)( unsigned int wait_ms );
 
 /***********************************************************************
  *           pw_wine_server_flush
@@ -1590,6 +1592,19 @@ DECLSPEC_EXPORT int pw_wine_server_terminate(void)
     return terminate_server ? terminate_server() : -1;
 }
 
+/***********************************************************************
+ *           pw_wine_server_snapshot
+ *
+ * For the title, when a game does not end: the in-process server prints each
+ * thread's server wait, message queue, last request and device number, from
+ * the calling thread under the server lock, waiting at most wait_ms for it
+ * (a lock held longer is reported with its holder). 0 when printed.
+ */
+DECLSPEC_EXPORT int pw_wine_server_snapshot( unsigned int wait_ms )
+{
+    return snapshot_server ? snapshot_server( wait_ms ) : -1;
+}
+
 /***********************************************************************
  *           connect_inprocess_server
  *
@@ -1633,6 +1648,7 @@ static int connect_inprocess_server(void)
     unregister_server_thread = dlsym( module, "pw_wine_thread_unregister" );
     flush_server = dlsym( module, "pw_wineserver_flush" );
     terminate_server = dlsym( module, "pw_wineserver_terminate" );
+    snapshot_server = dlsym( module, "pw_wineserver_snapshot" );
     {
         /* The synchronization device lives in ntdll (wine/ps5_ntsync.h); the
          * server creates and signals its objects through the same operations.
diff --git a/include/wine/ps5_ntsync.h b/include/wine/ps5_ntsync.h
index f2b366d..c5cf3e8 100644
--- a/include/wine/ps5_ntsync.h
+++ b/include/wine/ps5_ntsync.h
@@ -86,6 +86,8 @@ struct ps5_ntsync_ops
     /* timeout: absolute ns (UINT64_MAX: none) on CLOCK_REALTIME or CLOCK_MONOTONIC */
     int (*wait)( int all, const int *objects, uint32_t count, uint32_t owner, int alert,
                  uint64_t timeout, int realtime, uint32_t *index );
+    /* what an object is (the server's type and id or handle), for the device's dump */
+    int (*note)( int object, const char *tag );
 };
 
 /* NULL when the device is off: the code then takes its server paths. */
diff --git a/server/fd.c b/server/fd.c
index 58f8d9e..643489d 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -33,6 +33,10 @@
 #include <stdlib.h>
 #include <stdint.h>
 #include <poll.h>
+#ifdef HAVE_PTHREAD_NP_H
+# include <pthread.h>
+# include <pthread_np.h>
+#endif
 #ifdef HAVE_LINUX_MAJOR_H
 #include <linux/major.h>
 #endif
@@ -360,11 +364,29 @@ static const timeout_t user_shared_data_timeout = 16 * 10000;
  * pw_wineserver_call_direct, request.c) under this lock, which the server
  * thread holds except while it sleeps in kqueue/epoll. */
 pthread_mutex_t inprocess_server_mutex = PTHREAD_MUTEX_INITIALIZER;
+unsigned int inprocess_server_holder, inprocess_server_locks;
 int inprocess_direct_ok;      /* the main loop sleeps in kqueue/epoll: clients may run requests */
 int inprocess_wake_fd = -1;   /* written to wake the sleeping main loop */
 static timeout_t inprocess_sleep_until;   /* monotonic time the main loop sleeps until, 0 when awake */
 static unsigned int poll_users_epoch;     /* bumped when poll users are removed or change events */
 
+/* The holder is a kernel thread id, which the snapshot matches to the
+ * threads' unix ids. Read without the lock, so stored atomically. */
+void inprocess_server_locked(void)
+{
+#ifdef HAVE_PTHREAD_GETTHREADID_NP
+    __atomic_store_n( &inprocess_server_holder, (unsigned int)pthread_getthreadid_np(), __ATOMIC_RELAXED );
+#else
+    __atomic_store_n( &inprocess_server_holder, 1, __ATOMIC_RELAXED );
+#endif
+    __atomic_store_n( &inprocess_server_locks, inprocess_server_locks + 1, __ATOMIC_RELAXED );
+}
+
+void inprocess_server_unlocking(void)
+{
+    __atomic_store_n( &inprocess_server_holder, 0, __ATOMIC_RELAXED );
+}
+
 /* a client thread added a timeout: wake the main loop if it sleeps past it */
 static void inprocess_timeout_added( abstime_t when )
 {
@@ -382,6 +404,7 @@ static unsigned int inprocess_sleep( int timeout, const struct timespec *ts )
     if (timeout == -1) inprocess_sleep_until = TIMEOUT_INFINITE;
     else if (ts) inprocess_sleep_until = monotonic_time + ts->tv_sec * TICKS_PER_SEC + ts->tv_nsec / 100;
     else inprocess_sleep_until = monotonic_time + (timeout_t)timeout * 10000;
+    inprocess_server_unlocking();
     pthread_mutex_unlock( &inprocess_server_mutex );
     return poll_users_epoch;
 }
@@ -392,6 +415,7 @@ static unsigned int inprocess_sleep( int timeout, const struct timespec *ts )
 static int inprocess_wake( unsigned int epoch )
 {
     pthread_mutex_lock( &inprocess_server_mutex );
+    inprocess_server_locked();
     inprocess_sleep_until = 0;
     return epoch == poll_users_epoch;
 }
@@ -1084,6 +1108,7 @@ void main_loop(void)
 
 #ifdef WINE_INPROCESS_SERVER
     pthread_mutex_lock( &inprocess_server_mutex );
+    inprocess_server_locked();
 #endif
     set_current_time();
     server_start_time = current_time;
@@ -1102,11 +1127,13 @@ void main_loop(void)
         if (!active_users) break;  /* last user removed by a timeout */
 
 #ifdef WINE_INPROCESS_SERVER
+        inprocess_server_unlocking();
         pthread_mutex_unlock( &inprocess_server_mutex );
 #endif
         ret = poll( pollfd, nb_users, timeout );
 #ifdef WINE_INPROCESS_SERVER
         pthread_mutex_lock( &inprocess_server_mutex );
+        inprocess_server_locked();
 #endif
         set_current_time();
 
@@ -1123,6 +1150,7 @@ void main_loop(void)
         }
     }
 #ifdef WINE_INPROCESS_SERVER
+    inprocess_server_unlocking();
     pthread_mutex_unlock( &inprocess_server_mutex );
 #endif
 }
diff --git a/server/inproc_sync.c b/server/inproc_sync.c
index d2ad739..02f8e28 100644
--- a/server/inproc_sync.c
+++ b/server/inproc_sync.c
@@ -30,6 +30,7 @@
 
 #include "file.h"
 #include "handle.h"
+#include "process.h"
 #include "request.h"
 #include "thread.h"
 #include "user.h"
@@ -377,6 +378,41 @@ static int get_obj_inproc_sync( struct object *obj, int *type )
 
 #endif /* NTSYNC_IOC_EVENT_READ */
 
+#if defined(__PROSPERO__) && defined(NTSYNC_IOC_EVENT_READ)
+/* Tell the device what a number stands for, so a dump of its blocked waits
+ * names what each thread waits on: the object's type, and the thread or
+ * process id, else the handle the number was first asked for. */
+static void ps5_note_sync( int fd, struct object *obj, obj_handle_t handle )
+{
+    const struct unicode_str *name = &obj->ops->type->name;
+    char tag[24];
+    unsigned int i, used;
+
+    for (i = used = 0; i < name->len / sizeof(WCHAR) && used < 12; i++)
+        tag[used++] = name->str[i] < 0x80 ? (char)name->str[i] : '?';
+    if (obj->ops->type == &thread_type)
+        snprintf( tag + used, sizeof(tag) - used, " %04x", ((struct thread *)obj)->id );
+    else if (obj->ops->type == &process_type)
+        snprintf( tag + used, sizeof(tag) - used, " pid %04x", ((struct process *)obj)->id );
+    else
+        snprintf( tag + used, sizeof(tag) - used, " h%x", handle );
+    ps5_ntsync->note( fd, tag );
+}
+
+/* The device number of a thread's own sync object (what a wait on the
+ * thread's handle waits for), or -1, for the server's snapshot. */
+int ps5_object_device_number( struct object *sync )
+{
+    if (!sync || sync->ops != &inproc_sync_ops) return -1;
+    return ((struct inproc_sync *)sync)->fd;
+}
+#elif defined(__PROSPERO__)
+int ps5_object_device_number( struct object *sync )
+{
+    return -1;
+}
+#endif
+
 DECL_HANDLER(get_inproc_sync_fd)
 {
     struct object *obj;
@@ -390,7 +426,11 @@ DECL_HANDLER(get_inproc_sync_fd)
     else if (do_fsync()) reply->fsync_shm_idx = fsync_grab_shm_idx( fd );
 #ifdef __PROSPERO__
     /* the client holds its own reference to the number, as it would a descriptor */
-    else reply->fsync_shm_idx = ps5_ntsync->ref( fd );
+    else
+    {
+        reply->fsync_shm_idx = ps5_ntsync->ref( fd );
+        if (ps5_ntsync->note) ps5_note_sync( fd, obj, req->handle );
+    }
 #else
     else send_client_fd( current->process, fd, req->handle );
 #endif
diff --git a/server/request.c b/server/request.c
index c322de1..1978038 100644
--- a/server/request.c
+++ b/server/request.c
@@ -389,12 +389,17 @@ static void lock_server_for_client(void)
 
     for (i = 0; i < 200; i++)
     {
-        if (!pthread_mutex_trylock( &inprocess_server_mutex )) return;
+        if (!pthread_mutex_trylock( &inprocess_server_mutex ))
+        {
+            inprocess_server_locked();
+            return;
+        }
 #if defined(__i386__) || defined(__x86_64__)
         __asm__ __volatile__( "pause" );
 #endif
     }
