diff --git a/server/thread.c b/server/thread.c
index dec6851..a02e818 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -1194,7 +1194,11 @@ static int ps5_peek( int probe[2], unsigned int address, void *out, size_t size
     return read( probe[0], out, size ) == (ssize_t)size;
 }
 
-static void wait_watchdog( void *arg )
+#ifdef __PROSPERO__
+extern int ps5_object_device_number( struct object *sync );
+#endif
+
+static void wait_snapshot(void)
 {
     struct thread *thread;
     struct thread_wait *wait;
@@ -1203,13 +1207,24 @@ static void wait_watchdog( void *arg )
     fprintf( stderr, "wine-ps5: wait snapshot\n" );
     LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
     {
-        fprintf( stderr, "wine-ps5: thread tid=%04x suspend=%d/%d state=%d waiting=%d last_req=%d age_ms=%lld\n",
-                 thread->id, thread->suspend, thread->process->suspend, thread->state, thread->wait != NULL,
+        /* unix: the kernel thread, as the device and the lock holders name it;
+         * sync: the device number a wait on this thread's handle waits for */
+        fprintf( stderr, "wine-ps5: thread tid=%04x unix=%x sync=#%x suspend=%d/%d state=%d waiting=%d last_req=%d age_ms=%lld\n",
+                 thread->id, thread->unix_tid,
+#ifdef __PROSPERO__
+                 ps5_object_device_number( thread->sync ),
+#else
+                 -1,
+#endif
+                 thread->suspend, thread->process->suspend, thread->state, thread->wait != NULL,
                  thread->ps5_last_req, (long long)((monotonic_time - thread->ps5_last_req_time) / 10000) );
         /* Silent outside any wait for over a second: where its i386 code is,
          * from the WoW64 CPU area (TEB64 TlsSlots[WOW64_TLS_CPURESERVED]).
-         * The server runs in the game's process, so it can read it. */
-        if (!thread->wait && thread->teb && monotonic_time - thread->ps5_last_req_time > TICKS_PER_SEC)
+         * The server runs in the game's process, so it can read it. A 64-bit
+         * process keeps its own data in that slot. Only a process this host runs:
+         * a helper's TEB is an address of another process. */
+        if (thread->process->unix_pid == getpid() && is_wow64_process( thread->process ) && !thread->wait &&
+            thread->teb && monotonic_time - thread->ps5_last_req_time > TICKS_PER_SEC)
         {
             const unsigned char *cpu = *(unsigned char * const *)(ULONG_PTR)(thread->teb + 0x1480 + 8);
             if (cpu && *(const unsigned short *)(cpu + 2) == 0x14c /* IMAGE_FILE_MACHINE_I386 */)
@@ -1274,9 +1288,45 @@ static void wait_watchdog( void *arg )
             }
         }
     }
+}
+
+static void wait_watchdog( void *arg )
+{
+    wait_snapshot();
     add_timeout_user( -2 * TICKS_PER_SEC, wait_watchdog, NULL );
 }
 
+#ifdef WINE_INPROCESS_SERVER
+/* For the title, when a game does not end: the watchdog's snapshot once, from
+ * the calling thread under the server lock. A lock not free within wait_ms is
+ * reported with the kernel thread that holds it and how often it was taken
+ * meanwhile (0: stuck), and nothing is read. 0 when printed. */
+DECLSPEC_EXPORT int pw_wineserver_snapshot( unsigned int wait_ms )
+{
+    const unsigned int locks = __atomic_load_n( &inprocess_server_locks, __ATOMIC_RELAXED );
+    unsigned int waited;
+
+    for (waited = 0; pthread_mutex_trylock( &inprocess_server_mutex ); waited++)
+    {
+        if (waited >= wait_ms)
+        {
+            fprintf( stderr, "wine-ps5: snapshot: the server lock is held by unix=%x, taken %u times in %u ms; "
+                     "not read\n", __atomic_load_n( &inprocess_server_holder, __ATOMIC_RELAXED ),
+                     __atomic_load_n( &inprocess_server_locks, __ATOMIC_RELAXED ) - locks, wait_ms );
+            return -1;
+        }
+        usleep( 1000 );
+    }
+    inprocess_server_locked();
+    set_current_time();
+    fprintf( stderr, "wine-ps5: snapshot: server lock taken after %u ms\n", waited );
+    wait_snapshot();
+    inprocess_server_unlocking();
+    pthread_mutex_unlock( &inprocess_server_mutex );
+    return 0;
+}
+#endif
+
 static void start_wait_watchdog(void)
 {
     static int started;
