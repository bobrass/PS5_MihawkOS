From: PS5_Proton <local>
Subject: [PATCH] gpu-broker: a client in the owner's own process uses the owner's mappings

PS5_Proton can run one Windows program inside the title, beside the broker that serves its helpers, so that its code
and memory come from the title's own partition rather than the system pool (PS5_Proton docs/TITLE_CLIENT.md). That
program's Vulkan is a broker client like a helper's, but in the owner's address space. The owner maps every
host-visible buffer at the address it chooses, in its own process (allocate: map_host, then the GPU grant), while a
client maps one only over its own bare reservation of that address (patch 0013): in the owner's process every
allocation was refused, and a client's free (an unmap, or a reservation laid over it) would have taken the owner's own
mapping.

ps5_gpu_client_in_owner(), called before binding, marks such a client. Its host-visible buffers use the owner's mapping
as it is: nothing is mapped over it, and its free leaves the unmapping to the owner's FREE. A client in a process of its
own does not call it and behaves as before. The owner opens that client's slot with ps5_gpu_broker_open_in_owner(), the
only slot whose INIT may name the owner's own pid.
---
--- a/tooling/gpu-broker/client.c
+++ b/tooling/gpu-broker/client.c
@@ -330,6 +330,9 @@
 struct shared_source { uintptr_t address; int fd; uint64_t dmem_plus_one; };
 static int keep_sources;
 void ps5_gpu_client_keep_sources(void) { __atomic_store_n(&keep_sources,1,__ATOMIC_RELEASE); }
+/* ps5_gpu_client_in_owner: set once, before binding; never by a client in a process of its own. */
+static int in_owner;
+void ps5_gpu_client_in_owner(void) { __atomic_store_n(&in_owner,1,__ATOMIC_RELEASE); }
 static struct shared_source *sources;
 static size_t source_count,source_capacity;
 static pthread_mutex_t sources_lock=PTHREAD_MUTEX_INITIALIZER;
@@ -373,14 +376,17 @@
         (!window32 || pw_gpu_contains(RADV_PS5_WINDOW_BASE,RADV_PS5_WINDOW_BYTES,message.address,message.bytes));
     /* Only over this process's own reservation of a host range, still bare: an address the owner chose anywhere else
      * was taken where the kernel found a hole, which may lie inside the application's own reservations. */
-    const int ranged=okay && ranges_reserved && pw_gpu_host_range(message.address,message.bytes)>=0 &&
+    /* In the owner's process the owner has mapped the buffer at `at` already (its allocate): that mapping is this
+     * client's too. */
+    const int owned=okay && __atomic_load_n(&in_owner,__ATOMIC_ACQUIRE);
+    const int ranged=okay && !owned && ranges_reserved && pw_gpu_host_range(message.address,message.bytes)>=0 &&
         bare(at,message.bytes);
     if(ranged) {
         /* Over this process's own reservation of the range: a fixed mapping replaces it. */
         void *mapped=map_host_at(at,message.bytes,fd,message.argument[2]);
         okay=mapped==at;
         if(!okay) { void *again=at;sceKernelReserveVirtualRange(&again,message.bytes,PW_GPU_RESERVE_FIXED,16384); }
-    } else okay=false;
+    } else if(!owned)okay=false;
     /* Kept for a placed mapping of this memory (radv_ps5_memory_map_at): its direct-memory offset, or its shared
      * memory's descriptor; dropped when it is freed. */
     const bool kept=okay && __atomic_load_n(&keep_sources,__ATOMIC_ACQUIRE) &&
@@ -401,7 +407,8 @@
     /* The owner gives the range back when it answers, and the next ALLOC of any thread here may get it at once: nothing
      * here may map it, or still lay a reservation over it, by then (a lay after FREE tore down that thread's new
      * buffer). In a reserved range the mapping goes back to a reservation (laid over it, it replaces it). */
-    if(memory->physical!=PS5_GPU_LOCAL_MEMORY) {
+    /* In the owner's process the mapping is the owner's: its free unmaps it. */
+    if(memory->physical!=PS5_GPU_LOCAL_MEMORY && !__atomic_load_n(&in_owner,__ATOMIC_ACQUIRE)) {
         void *at=memory->cpu;
         if(!(ranges_reserved && pw_gpu_host_range((uint64_t)(uintptr_t)at,memory->bytes)>=0 &&
              !sceKernelReserveVirtualRange(&at,memory->bytes,PW_GPU_RESERVE_FIXED,16384) && at==memory->cpu))
--- a/tooling/gpu-broker/client.h
+++ b/tooling/gpu-broker/client.h
@@ -15,6 +15,10 @@
  * WoW64 maps all of its memory below 4 GiB): call before Vulkan allocates. The client then keeps each host-visible
  * allocation's direct-memory offset, which a placed mapping needs; without it none is kept and nothing is placed. */
 void ps5_gpu_client_keep_sources(void);
+/* Before binding: this client runs in the owner's own process (a Windows program run inside the title). Each host-visible
+ * buffer is already mapped there by the owner, at the address it chose: the client uses that mapping as it is, never maps
+ * over it, and leaves unmapping to the owner. */
+void ps5_gpu_client_in_owner(void);
 /* For PS5_Proton's Wine module loader (its wine/ps5/pw_wine_dl.h), which calls it with its own symbol lookup as it
  * opens this module: bind then looks up ntdll's pw_ps5_child_doomed, which the client calls once, when it gives the
  * broker up for good (no answer in 15 s, the connection gone, a malformed reply, a free not taken back), so the
--- a/tooling/gpu-broker/protocol.h
+++ b/tooling/gpu-broker/protocol.h
@@ -50,7 +50,8 @@
  * spawn result before bootstrap; a client cannot replace that declaration. */
 static inline int pw_gpu_client_pid(int expected,uint64_t requested,int owner)
 {
-    return expected>=0 && requested>0 && requested<=INT32_MAX && requested!=(uint64_t)owner &&
+    /* The owner's own pid only for the slot the owner opened for itself (ps5_gpu_broker_open_in_owner). */
+    return expected>=0 && requested>0 && requested<=INT32_MAX && (requested!=(uint64_t)owner || expected==owner) &&
            (!expected || requested==(uint64_t)expected);
 }
 /* Window swapchain: width/height packed in argument[0], stride/full HWND in
--- a/tooling/gpu-broker/server.cpp
+++ b/tooling/gpu-broker/server.cpp
@@ -1382,6 +1382,7 @@
     if(pid<=0 || pid==getpid()) {errno=EINVAL;return -1;}
     return open_client(cookie,pid);
 }
+int ps5_gpu_broker_open_in_owner(int *cookie) {return open_client(cookie,getpid());}
 void ps5_gpu_broker_close(int cookie,int service)
 {
     auto &b=broker_state;
--- a/tooling/gpu-broker/server.h
+++ b/tooling/gpu-broker/server.h
@@ -15,6 +15,9 @@
 /* Bind to the owner's acknowledged payload PID before bootstrap gives the
  * helper its broker descriptor. INIT must match; window packets require it. */
 int ps5_gpu_broker_open_for_pid(int *cookie,int pid);
+/* A client in the owner's own process (a Windows program run inside the title): its INIT names the owner's pid, and its
+ * Vulkan uses the owner's mappings (ps5_gpu_client_in_owner). It ends with the owner. */
+int ps5_gpu_broker_open_in_owner(int *cookie);
 /* Game mode (src/pw_window_direct.h): the native pid whose full-screen frames are flipped directly, or 0. No lock. */
 int ps5_gpu_broker_game_mode();
