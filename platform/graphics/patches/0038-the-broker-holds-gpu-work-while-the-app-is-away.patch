From: PS5_Proton <local>
Subject: [PATCH] gpu-broker: hold GPU work and flips while the app is away, with nothing in flight

When another app or a native game comes to the front, the system freezes the title and its helpers, and the broker's
thread blocked in sceAgcSuspendPoint with work it had already submitted still in flight (the Pro's last flight row
before its kernel panic of 2026-10-27, on closing a native game: broker busy in phase suspend:23, fences 146,499 issued
and 146,498 completed). ps5_gpu_broker_set_away, which the title calls on every tick with the system's word on the app
(PS5_Proton's src/pw_suspend.h), drains what is in flight (up to 1 s) when the app goes away, and from then on every
client's next submission or present waits in its service thread, without the lock, until the app is back. Nothing new
is started for the GPU and nothing flipped while the app is away; allocations, frees and the rest go on. The broker's
log says each change, how much was in flight, and how many messages waited.
---
--- a/tooling/gpu-broker/server.cpp
+++ b/tooling/gpu-broker/server.cpp
@@ -36,6 +36,7 @@
 #include <atomic>
 #include <fcntl.h>
 #include <poll.h>
+#include <time.h>
 #include <sys/mman.h>
 #include <sys/socket.h>
 #include <unistd.h>
@@ -666,6 +667,9 @@
 struct Broker {
     pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER,display_lock=PTHREAD_MUTEX_INITIALIZER;
     pthread_cond_t pin_released=PTHREAD_COND_INITIALIZER;   // a present link's frame unpinned (Client::pin_*)
+    // The app is not in the foreground (ps5_gpu_broker_set_away, under lock): submissions and presents wait here.
+    bool away=false;uint64_t away_held=0;
+    pthread_cond_t away_changed=PTHREAD_COND_INITIALIZER;
     Client clients[32];
     Ps5GpuDisplay display;
     uint64_t window=0x240000000ull,high=0x5100000000ull;
@@ -879,6 +883,18 @@
                 c.ended=true;break;
             }
             sequence=m.sequence;m.status=EINVAL;int fd=-1;bool sent_away=false;   // sent_away: fd is closed once sent
+            // Away (ps5_gpu_broker_set_away): no new GPU work and no flip while the app is not in the foreground. This one
+            // waits, without the lock, until it is again; the client's thread waits on its reply meanwhile.
+            if(c.pid>0 && b.away && (m.operation==PW_GPU_SUBMIT || m.operation==PW_GPU_SWAPCHAIN ||
+                                     m.operation==PW_GPU_WINDOW_SWAPCHAIN)) {
+                ++b.away_held;
+                // Timed, so a client closed or a broker stopped meanwhile is seen within 100 ms.
+                while(b.away && !b.stopping && !c.ended) {
+                    struct timespec until;clock_gettime(CLOCK_REALTIME,&until);
+                    until.tv_nsec+=100000000;if(until.tv_nsec>=1000000000) { until.tv_nsec-=1000000000;++until.tv_sec; }
+                    pthread_cond_timedwait(&b.away_changed,&b.lock,&until);
+                }
+            }
             if(present && m.operation!=PW_GPU_SWAPCHAIN && m.operation!=PW_GPU_WINDOW_SWAPCHAIN && m.operation!=PW_GPU_TIMING) {
                 // Refused (EINVAL): the present link carries presents alone.
             } else if(m.operation==PW_GPU_INIT && c.pid<0 && pw_gpu_client_pid(c.expected_pid,m.argument[0],getpid())) {
@@ -1251,6 +1267,23 @@
     pthread_mutex_unlock(&b.capture_lock);
     return asked;
 }
+void ps5_gpu_broker_set_away(bool away)
+{
+    auto &b=broker_state;
+    if(__atomic_load_n(&b.away,__ATOMIC_RELAXED)==away)return;
+    pthread_mutex_lock(&b.lock);
+    __atomic_store_n(&b.away,away,__ATOMIC_RELAXED);
+    // Nothing in flight when the system freezes the app: what was submitted completes now, and nothing new starts.
+    if(away && b.started && fences.page.cpu) {
+        const bool drained=drain(1000000000ull);
+        fprintf(b.log,"gpu-broker away=1 drained=%d fences=%u/%u\n",drained,fences.issued,completed());
+    } else if(!away && b.started && fences.page.cpu) {
+        fprintf(b.log,"gpu-broker away=0 fences=%u/%u held=%llu\n",fences.issued,completed(),(unsigned long long)b.away_held);
+    }
+    if(!away)pthread_cond_broadcast(&b.away_changed);
+    if(b.log)fflush(b.log);
+    pthread_mutex_unlock(&b.lock);
+}
 void ps5_gpu_broker_health(Ps5GpuBrokerHealth *health)
 {
     auto &b=broker_state;
--- a/tooling/gpu-broker/server.h
+++ b/tooling/gpu-broker/server.h
@@ -47,6 +47,10 @@
  * Any thread. */
 struct Ps5GpuBrokerHealth { unsigned lock_busy,display_busy,fences_issued,fences_completed;const char *phase;unsigned long long phase_ms;int holder_tid; };
 void ps5_gpu_broker_health(Ps5GpuBrokerHealth *health);
+/* Whether the application is away from the foreground (PS5_Proton's src/pw_suspend.h): from away, the broker drains what
+ * is in flight (up to 1 s) and holds every client's next submission and present until it is back. Any thread; a repeat
+ * of the current state costs one atomic load. */
+void ps5_gpu_broker_set_away(bool away);
 /* Where the memory a client maps comes from: alloc gives a new object of bytes (or -1), touch writes through
  * [from, to) of one in another process before the broker maps it for the GPU (0, or -1). An application whose clients
  * outlive it sets both, so none of that memory is its own; unset, the broker makes it, as before. */
