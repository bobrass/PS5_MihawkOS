From: PS5_Proton <local>
Subject: [PATCH] gpu-broker: a display swapchain larger than the screen is shown clipped, as a window's is

A program on the display route (no WINE_PS5_WINDOW_SURFACES: a library entry such as the console's 250900 entry, or a
probe) presents through a surface for the whole display, but Wine still makes its swapchain the window's client area
(the surface capabilities), and that may be larger than the screen. The Binding of Isaac set to borderless fullscreen
has a 1921x1080 window. Patch 0036 lets a window's swapchain take up to 2176x1408 and kept a display swapchain at
1920x1080, so on the display route the broker WSI refused it ("gpu-wsi rejected extent=1921x1080 count=2 format=44",
VK_ERROR_INITIALIZATION_FAILED), Zink killed the swapchain, and the game later wrote to NULL in libgallium_wgl.dll
(zink_resource.c resource_create, a front buffer made from a back buffer with no display target: cdt->refcount++ at
+0x30F138), at its intro (PS5_Proton, the Pro, 2026-10-29, both runs wh-pro-2026-10-29-with and -b3-without).

Windows creates that swapchain and shows the part on screen, and the owner already does so for a window. So a display
swapchain takes the size a window's does (pw_gpu_display_image, beside pw_gpu_window_image, in the client and the owner),
and the owner presents its top-left 1920x1080 with the image's own row pitch (pw_gpu_display_shown); an image no larger
than the screen is shown whole and scaled, as before. The broker WSI's display limit goes with it
(display-extent-wsi.patch, applied after window-extent-wsi.patch). PS5_Mesa and PS5_Vulkan are unchanged.
---
--- a/tooling/gpu-broker/client.c
+++ b/tooling/gpu-broker/client.c
@@ -276,9 +276,9 @@
 }
 int ps5_gpu_client_swapchain(const void *pixels,unsigned width,unsigned height,unsigned pitch,unsigned bgra)
 {
-    if(!width || width>1920 || !height || height>1080 || pitch<width*4 || pitch>1920*4 || bgra>1)return EINVAL;
     PwGpuMessage message={.operation=PW_GPU_SWAPCHAIN,.address=(uint64_t)pixels,.bytes=(uint64_t)pitch*height,
                          .argument={width,height,pitch,bgra}};
+    if(!pw_gpu_display_image(&message))return EINVAL;
     return present_timed(&message,pixels,(size_t)pitch*height);
 }
 int ps5_gpu_client_window_swapchain(const void *pixels,unsigned width,unsigned height,unsigned stride,unsigned bgra,
--- a/tooling/gpu-broker/display.cpp
+++ b/tooling/gpu-broker/display.cpp
@@ -125,7 +125,8 @@
 int Ps5GpuDisplay::present(const void *pixels,unsigned w,unsigned h,unsigned pitch,FILE *log,const char *capture,bool bgra,
     int cursor_x,int cursor_y)
 {
-    if(!pixels || !w || w>width || !h || h>height || pitch<w*4 || pitch>width*4)return EINVAL;
+    // A row may be longer than the part shown: the top-left of a swapchain larger than the screen (pw_gpu_display_shown).
+    if(!pixels || !w || w>width || !h || h>height || pitch<w*4 || pitch>2176*4)return EINVAL;
     if(handle<0) {
         const int status=open(log);
         if(status)return status;
--- /dev/null
+++ b/tooling/gpu-broker/display-extent-wsi.patch
@@ -0,0 +1,16 @@
+--- a/src/vulkan/wsi/wsi_common_videoout.c
++++ b/src/vulkan/wsi/wsi_common_videoout.c
+@@ -516,9 +516,11 @@
+     * program that names one without checking the list got no swapchain at all (Wine's vulkan-1, vulkan.c:975).
+     * A window's swapchain is its client area, which may be larger than the screen (Steam's restored window is 1922x1081):
+     * the owner clips it to the screen as Windows does, up to the size it composes (PS5_Proton's src/pw_window_page.h,
+-    * 2176x1408). Only a swapchain for the whole display is held to the display's size. */
++    * 2176x1408). A swapchain for the whole display is a window's client area as well (Wine's surface capabilities;
++    * The Binding of Isaac's borderless fullscreen window is 1921x1080): it takes the same size, and the owner shows
++    * its top-left part (pw_gpu_display_shown). */
+    const struct broker_surface *surface=(const void *)s;
+-   const uint32_t max_width=surface->hwnd ? 2176 : 1920,max_height=surface->hwnd ? 1408 : 1080;
++   const uint32_t max_width=2176,max_height=1408;
+    if(!info->imageExtent.width || info->imageExtent.width>max_width || !info->imageExtent.height ||
+       info->imageExtent.height>max_height ||
+       info->minImageCount>VIDEOOUT_BUFFERS ||
--- a/tooling/gpu-broker/protocol.h
+++ b/tooling/gpu-broker/protocol.h
@@ -67,6 +67,21 @@
            !(stride&3) && hwnd && m->argument[2] && m->argument[3]<=1 &&
            m->bytes==(uint64_t)height*stride && m->address && !(m->address&3);
 }
+/* Display swapchain: width, height, pitch and BGRA in argument[0..3]. Its image is the window's client area too (Wine's
+ * surface capabilities), which may be larger than the screen: The Binding of Isaac's borderless fullscreen window is
+ * 1921x1080. So it takes the size a window's does, and the owner shows its top-left part (pw_gpu_display_shown). */
+static inline int pw_gpu_display_image(const PwGpuMessage *m)
+{
+    const uint64_t width=m->argument[0],height=m->argument[1],pitch=m->argument[2];
+    return width && width<=2176 && height && height<=1408 && pitch>=width*4 && pitch<=2176*4 && !(pitch&3) &&
+           m->argument[3]<=1 && m->bytes==height*pitch && m->address && !(m->address&3);
+}
+/* The part of a display image on screen: its top-left, at most the screen's 1920x1080 (a smaller image is scaled). */
+static inline void pw_gpu_display_shown(const PwGpuMessage *m,unsigned *width,unsigned *height)
+{
+    *width=m->argument[0]>1920 ? 1920u : (unsigned)m->argument[0];
+    *height=m->argument[1]>1080 ? 1080u : (unsigned)m->argument[1];
+}
 /* Reject wrapped resources; subtraction bounds the requested range. */
 static inline int pw_gpu_contains(uint64_t base,uint64_t length,uint64_t address,uint64_t bytes)
 {
--- a/tooling/gpu-broker/server.cpp
+++ b/tooling/gpu-broker/server.cpp
@@ -1059,9 +1059,7 @@
                 }break;
             case PW_GPU_SWAPCHAIN:
                 if(wedged) { m.status=EIO;break; }
-                if(m.argument[0]>0 && m.argument[0]<=1920 && m.argument[1]>0 && m.argument[1]<=1080 &&
-                   m.argument[2]>=m.argument[0]*4 && m.argument[2]<=1920*4 && m.argument[3]<=1 &&
-                   m.bytes==m.argument[1]*m.argument[2] && !(m.address&3) && owned(c,m.address,m.bytes)) {
+                if(pw_gpu_display_image(&m) && owned(c,m.address,m.bytes)) {
                     // No cache maintenance: the client waited for its frame's fence, and GPU writes reach CPU reads
                     // coherently (graphics-child-gpu-coherence-*). The copy runs outside the broker's lock, under the
                     // display's own, so other clients' submissions go on meanwhile: this client's buffers cannot go
@@ -1079,10 +1077,11 @@
                     const bool shown=!b.cover && may_show(b,c.cookie,c.pid,radv_ps5_now_ns());
                     if(b.cover)++b.cover_held_frames;
                     if(shown) {
-                        int cursor_x,cursor_y;screen_cursor(0,0,(unsigned)m.argument[0],(unsigned)m.argument[1],cursor_x,cursor_y);
+                        unsigned shown_width,shown_height;pw_gpu_display_shown(&m,&shown_width,&shown_height);
+                        int cursor_x,cursor_y;screen_cursor(0,0,shown_width,shown_height,cursor_x,cursor_y);
                         std::string asked=take_capture(b);
                         const std::string &picture=asked.empty() ? capture : asked;
-                        m.status=b.display.present((void *)m.address,(unsigned)m.argument[0],(unsigned)m.argument[1],
+                        m.status=b.display.present((void *)m.address,shown_width,shown_height,
                             (unsigned)m.argument[2],b.log,picture.empty() ? nullptr : picture.c_str(),m.argument[3]!=0,
                             cursor_x,cursor_y);
                     } else m.status=0;
--- a/tools/build-gpu-broker-client.sh
+++ b/tools/build-gpu-broker-client.sh
@@ -78,6 +78,8 @@
     patch --batch -p1 -d "$out/source" < "$out/patches/present-mode-wsi.patch"
     cp "$root/tooling/gpu-broker/window-extent-wsi.patch" "$out/patches/"   # a window larger than the screen, clipped
     patch --batch -p1 -d "$out/source" < "$out/patches/window-extent-wsi.patch"
+    cp "$root/tooling/gpu-broker/display-extent-wsi.patch" "$out/patches/"   # a display swapchain larger than the screen too
+    patch --batch -p1 -d "$out/source" < "$out/patches/display-extent-wsi.patch"
     cp "$root/tooling/gpu-broker/pw_present_retry.h" "$out/source/src/vulkan/wsi/"   # PS5_Proton's, beside the WSI
     python3 - "$radv" "$out" <<'PYWSI'
 import json,shlex,subprocess,sys
