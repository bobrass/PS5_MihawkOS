From: PS5_Proton <local>
Subject: [PATCH] gpu-broker: a window larger than the screen gets its swapchain and is shown clipped

A window's Vulkan swapchain is its client area (Wine sets the surface's current, smallest and largest extent to it), and
a window may be larger than the screen: Steam's main window, restored after being minimized, has a client area of
1922x1081 at (-1,-1). The broker WSI refused any extent above 1920x1080 (broker_create, from PS5_Mesa's
ps5/broker/radv-gpu-broker-wsi.patch at f7ce91ac4c3), so Steam's GPU process got VK_ERROR_INITIALIZATION_FAILED, tried
again about 48 times a second, and nothing reached the screen: it stayed black while the GPU kept working (PS5_Proton,
base PS5, 2026-10-27, Steam downloading: 10,340 "gpu-wsi rejected extent=1922x1081" lines, the flight recorder's flips
at +0 for 47 s with its fences still advancing). Windows creates that swapchain and shows the part on screen.

The owner already composes a window image larger than the screen, clipped to it, up to 2176x1408 (the size of a GDI
window page, PS5_Proton's src/pw_window_page.h; pw_windows_compose_effects checks the same bound), and the direct flip
already refuses a frame that is not the screen's size. So a window's swapchain (a surface bound to an HWND) and its
frame (pw_gpu_window_image) now take up to 2176x1408; a swapchain for the whole display stays at 1920x1080. Applied after
the present-mode patch, to the same file; PS5_Mesa and PS5_Vulkan are unchanged.
---
--- a/tooling/gpu-broker/protocol.h
+++ b/tooling/gpu-broker/protocol.h
@@ -61,7 +61,9 @@
 {
     const uint32_t width=(uint32_t)m->argument[0],height=(uint32_t)(m->argument[0]>>32);
     const uint32_t stride=(uint32_t)m->argument[1],hwnd=(uint32_t)(m->argument[1]>>32);
-    return width && width<=1920 && height && height<=1080 && stride>=width*4 && stride<=1920*4 &&
+    /* A window may be larger than the screen (its client area: Steam's restored window is 1922x1081); the owner
+     * clips it, up to the size it composes (PS5_Proton's src/pw_window_page.h, 2176x1408). */
+    return width && width<=2176 && height && height<=1408 && stride>=width*4 && stride<=2176*4 &&
            !(stride&3) && hwnd && m->argument[2] && m->argument[3]<=1 &&
            m->bytes==(uint64_t)height*stride && m->address && !(m->address&3);
 }
--- /dev/null
+++ b/tooling/gpu-broker/window-extent-wsi.patch
@@ -0,0 +1,27 @@
+--- a/src/vulkan/wsi/wsi_common_videoout.c
++++ b/src/vulkan/wsi/wsi_common_videoout.c
+@@ -513,8 +513,14 @@
+    const VkSwapchainCreateInfoKHR *info,const VkAllocationCallbacks *a,struct wsi_swapchain **out)
+ {
+    /* Any present mode is presented as FIFO (c->base.present_mode): Windows drivers offer IMMEDIATE and MAILBOX, and a
+-    * program that names one without checking the list got no swapchain at all (Wine's vulkan-1, vulkan.c:975). */
+-   if(!info->imageExtent.width || info->imageExtent.width>1920 || !info->imageExtent.height || info->imageExtent.height>1080 ||
++    * program that names one without checking the list got no swapchain at all (Wine's vulkan-1, vulkan.c:975).
++    * A window's swapchain is its client area, which may be larger than the screen (Steam's restored window is 1922x1081):
++    * the owner clips it to the screen as Windows does, up to the size it composes (PS5_Proton's src/pw_window_page.h,
++    * 2176x1408). Only a swapchain for the whole display is held to the display's size. */
++   const struct broker_surface *surface=(const void *)s;
++   const uint32_t max_width=surface->hwnd ? 2176 : 1920,max_height=surface->hwnd ? 1408 : 1080;
++   if(!info->imageExtent.width || info->imageExtent.width>max_width || !info->imageExtent.height ||
++      info->imageExtent.height>max_height ||
+       info->minImageCount>VIDEOOUT_BUFFERS ||
+       (info->imageFormat!=VK_FORMAT_B8G8R8A8_UNORM && info->imageFormat!=VK_FORMAT_B8G8R8A8_SRGB)) {
+       fprintf(stderr,"gpu-wsi rejected extent=%ux%u count=%u format=%d mode=%d flags=%u usage=%u\n",
+@@ -529,7 +535,6 @@
+    const struct wsi_cpu_image_params params={.base.image_type=WSI_IMAGE_TYPE_CPU};
+    VkResult result=wsi_swapchain_init(w,&c->base,device,info,&params.base,a);
+    if(result!=VK_SUCCESS) { mtx_destroy(&c->lock);vk_free(a,c);return result; }
+-   const struct broker_surface *surface=(const void *)s;
+    c->hwnd=surface->hwnd;c->generation=surface->generation;
+    c->base.destroy=broker_destroy;c->base.get_wsi_image=broker_image;c->base.acquire_next_image=broker_acquire;
+    c->base.release_images=broker_release;c->base.queue_present=broker_present;c->base.wait_for_present=broker_wait;
--- a/tools/build-gpu-broker-client.sh
+++ b/tools/build-gpu-broker-client.sh
@@ -76,6 +76,8 @@
     patch --batch -p1 -d "$out/source" < "$out/patches/async-present-wsi.patch"
     cp "$root/tooling/gpu-broker/present-mode-wsi.patch" "$out/patches/"   # any present mode, presented as FIFO
     patch --batch -p1 -d "$out/source" < "$out/patches/present-mode-wsi.patch"
+    cp "$root/tooling/gpu-broker/window-extent-wsi.patch" "$out/patches/"   # a window larger than the screen, clipped
+    patch --batch -p1 -d "$out/source" < "$out/patches/window-extent-wsi.patch"
     cp "$root/tooling/gpu-broker/pw_present_retry.h" "$out/source/src/vulkan/wsi/"   # PS5_Proton's, beside the WSI
     python3 - "$radv" "$out" <<'PYWSI'
 import json,shlex,subprocess,sys
