/* The x87 register aliases the CPU executes and LLVM rejects (tools/ia32-cpu-decode-check.sh), named
 * as GNU objdump names them: FSTP1/8/9 are FSTP ST(i), FXCH4/7 FXCH, FCOM2 FCOM, FCOMP3/5 FCOMP;
 * FENI, FDISI and FSETPM (8087/287 controls) run as FNOP. */
PW_IA32_FORM(fstp1_sti,  "fstp1",  PRI, 0xD9, SEL(3,REG,X), ANY, ANY, OPS(STi,NONE,NONE), NOF, NOF, NOF, NOATT)
PW_IA32_FORM(feni,       "feni",   PRI, 0xDB, SEL(4,REG,0), ANY, ANY, OPS(NONE,NONE,NONE), NOF, NOF, NOF, NOATT)
PW_IA32_FORM(fdisi,      "fdisi",  PRI, 0xDB, SEL(4,REG,1), ANY, ANY, OPS(NONE,NONE,NONE), NOF, NOF, NOF, NOATT)
PW_IA32_FORM(fsetpm,     "fsetpm", PRI, 0xDB, SEL(4,REG,4), ANY, ANY, OPS(NONE,NONE,NONE), NOF, NOF, NOF, NOATT)
PW_IA32_FORM(fcom2_sti,  "fcom2",  PRI, 0xDC, SEL(2,REG,X), ANY, ANY, OPS(STi,NONE,NONE), NOF, NOF, NOF, NOATT)
